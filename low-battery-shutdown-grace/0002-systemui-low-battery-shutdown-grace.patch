+    private boolean isValidLowBatteryShutdownDeadline(long deadline, long now) {
+        if (deadline <= now) {
+            return false;
+        }
+        final long remaining = deadline - now;
+        final long configuredDelay = Math.max(1L, mContext.getResources().getInteger(
+                com.android.internal.R.integer.config_lowBatteryShutdownDelayMs));
+        return remaining <= configuredDelay + LOW_BATTERY_SHUTDOWN_EVENT_TOLERANCE_MS;
+    }
+
+    private void handleLowBatteryShutdownEvent(Intent intent) {
+        final int state = intent.getIntExtra(
+                BatteryManager.EXTRA_LOW_BATTERY_SHUTDOWN_STATE, 0);
+        final long generation = intent.getLongExtra(
+                BatteryManager.EXTRA_LOW_BATTERY_SHUTDOWN_GENERATION, -1);
+        final long eventSequence = intent.getLongExtra(
+                BatteryManager.EXTRA_LOW_BATTERY_SHUTDOWN_EVENT_SEQUENCE, -1);
+        if ((state != BatteryManager.LOW_BATTERY_SHUTDOWN_STATE_PENDING
+                && state != BatteryManager.LOW_BATTERY_SHUTDOWN_STATE_CANCELED)
+                || generation <= 0 || eventSequence <= 0
+                || eventSequence <= mLastLowBatteryShutdownEventSequence) {
+            return;
+        }
+
+        if (state == BatteryManager.LOW_BATTERY_SHUTDOWN_STATE_PENDING) {
+            final long deadline = intent.getLongExtra(
+                    BatteryManager.EXTRA_LOW_BATTERY_SHUTDOWN_DEADLINE, -1);
+            if (!isValidLowBatteryShutdownDeadline(deadline, SystemClock.elapsedRealtime())) {
+                mLastLowBatteryShutdownEventSequence = eventSequence;
+                if (generation >= mLowBatteryShutdownGeneration) {
+                    clearLowBatteryShutdownUi(generation);
+                }
+                return;
+            }
+            if (generation <= mLastCanceledLowBatteryShutdownGeneration
+                    || (mLowBatteryShutdownActive
+                    && generation < mLowBatteryShutdownGeneration)) {
+                mLastLowBatteryShutdownEventSequence = eventSequence;
+                return;
+            }
+            if (mLowBatteryShutdownActive && generation == mLowBatteryShutdownGeneration) {
+                mLastLowBatteryShutdownEventSequence = eventSequence;
+                return;
+            }
+
+            mLastLowBatteryShutdownEventSequence = eventSequence;
+            if (mLowBatteryShutdownActive) {
+                clearLowBatteryShutdownUi(mLowBatteryShutdownGeneration);
+            }
+            mLowBatteryShutdownGeneration = generation;
+            mLowBatteryShutdownDeadlineElapsedRealtime = deadline;
+            mLowBatteryShutdownActive = true;
+            mLowBatteryShutdownNotificationShown = false;
+            showLowBatteryShutdownDialog();
+            return;
+        }
+
+        if (mLowBatteryShutdownActive && generation < mLowBatteryShutdownGeneration) {
+            mLastLowBatteryShutdownEventSequence = eventSequence;
+            return;
+        }
+        mLastLowBatteryShutdownEventSequence = eventSequence;
+        clearLowBatteryShutdownUi(generation);
+    }
+
+    private boolean isCurrentLowBatteryShutdownDialog(SystemUIDialog dialog, long generation) {
+        return mLowBatteryShutdownActive
+                && mLowBatteryShutdownGeneration == generation
+                && mLowBatteryShutdownDialog == dialog;
+    }
+
+    private void showLowBatteryShutdownDialog() {
+        final long generation = mLowBatteryShutdownGeneration;
+        final long remaining = mLowBatteryShutdownDeadlineElapsedRealtime
+                - SystemClock.elapsedRealtime();
+        final int remainingSeconds = (int) Math.max(1L, (remaining + 999L) / 1000L);
+        final SystemUIDialog d = mSystemUIDialogFactory.create();
+        d.setIconAttribute(android.R.attr.alertDialogIcon);
+        d.setTitle(R.string.low_battery_shutdown_title);
+        d.setMessage(mContext.getString(R.string.low_battery_shutdown_message,
+                remainingSeconds));
+        d.setPositiveButton(R.string.low_battery_shutdown_got_it,
+                (dialog, which) -> {
+                    if (isCurrentLowBatteryShutdownDialog(d, generation)) {
+                        showLowBatteryShutdownNotification();
+                    }
+                });
+        d.setShowForAllUsers(true);
+        d.setCancelable(false);
+        d.setOnDismissListener(dialog -> {
+            if (isCurrentLowBatteryShutdownDialog(d, generation)) {
+                mLowBatteryShutdownDialog = null;
+                showLowBatteryShutdownNotification();
+            }
+        });
+        d.getWindow().addFlags(WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON
+                | WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        mLowBatteryShutdownDialog = d;
+        d.show();
+    }
+
+    private void showLowBatteryShutdownNotification() {
+        if (!mLowBatteryShutdownActive || mLowBatteryShutdownNotificationShown) {
+            return;
+        }
+        final long now = SystemClock.elapsedRealtime();
+        if (!isValidLowBatteryShutdownDeadline(
+                mLowBatteryShutdownDeadlineElapsedRealtime, now)) {
+            clearLowBatteryShutdownUi(mLowBatteryShutdownGeneration);
+            return;
+        }
+        final long remaining = mLowBatteryShutdownDeadlineElapsedRealtime - now;
+        final String contentText = mContext.getString(R.string.low_battery_shutdown_notification);
+        final Notification.Builder nb = new Notification.Builder(
+                mContext, NotificationChannels.BATTERY)
+                .setSmallIcon(R.drawable.ic_power_low)
+                .setWhen(System.currentTimeMillis() + remaining)
+                .setShowWhen(true)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .setContentTitle(mContext.getString(R.string.low_battery_shutdown_title))
+                .setContentText(contentText)
+                .setVisibility(Notification.VISIBILITY_PUBLIC)
+                .setUsesChronometer(true)
+                .setChronometerCountDown(true)
+                .setColor(Utils.getColorAttrDefaultColor(mContext,
+                        android.R.attr.colorError));
+        NotificationUtils.overrideNotificationAppName(mContext, nb, false);
+        mNoMan.notifyAsUser(TAG_LOW_BATTERY_SHUTDOWN, SystemMessage.NOTE_POWER_LOW,
+                nb.build(), UserHandle.ALL);
+        mLowBatteryShutdownNotificationShown = true;
+    }
+
+    private void clearLowBatteryShutdownUi(long canceledGeneration) {
+        mLowBatteryShutdownActive = false;
+        mLastCanceledLowBatteryShutdownGeneration = Math.max(
+                mLastCanceledLowBatteryShutdownGeneration, canceledGeneration);
+        mLowBatteryShutdownGeneration = Math.max(mLowBatteryShutdownGeneration,
+                canceledGeneration);
+        mLowBatteryShutdownDeadlineElapsedRealtime = 0;
+        mLowBatteryShutdownNotificationShown = false;
+        final SystemUIDialog dialog = mLowBatteryShutdownDialog;
+        mLowBatteryShutdownDialog = null;
+        if (dialog != null) {
+            dialog.dismiss();
+        }
+        mNoMan.cancelAsUser(TAG_LOW_BATTERY_SHUTDOWN, SystemMessage.NOTE_POWER_LOW,
+                UserHandle.ALL);
+    }
