+    private final class LowBatteryShutdownReceiver extends BroadcastReceiver {
+
+        public void init() {
+            IntentFilter filter = new IntentFilter(
+                    BatteryManager.ACTION_LOW_BATTERY_SHUTDOWN_WARNING);
+            Intent stickyIntent = mContext.registerReceiverAsUser(this, UserHandle.ALL, filter,
+                    android.Manifest.permission.DEVICE_POWER, mHandler,
+                    Context.RECEIVER_NOT_EXPORTED);
+            if (stickyIntent != null) {
+                mHandler.post(() -> handleLowBatteryShutdownEvent(stickyIntent));
+            }
+        }
+
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            handleLowBatteryShutdownEvent(intent);
+        }
+    }
